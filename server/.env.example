# ==========================================
# University Academic Portal - Backend Config
# ==========================================

# Server Port
PORT=5000

# Environment: development | production | test
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/academic_portal?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/academic_portal

# JWT Configuration
JWT_SECRET=srmap_academic_project_mgmt_jwt_secret_2026_key
JWT_EXPIRES_IN=7d

# University Domain Restriction
ALLOWED_EMAIL_DOMAIN=@srmap.edu.in
ALLOWED_HOSTED_DOMAIN=srmap.edu.in

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Cloudinary File Storage Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
